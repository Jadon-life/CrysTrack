# CrysTrack application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Database
DATABASE_URL=

# AI - OpenRouter
OPENROUTER_API_KEY=

# Verified private OpenRouter model used by CrysTrack.
# Application code defaults to this model if overrides are omitted.
OPENROUTER_CHAT_MODEL=openai/gpt-oss-20b
OPENROUTER_ANALYSIS_MODEL=openai/gpt-oss-20b

# Exchange rates
EXCHANGE_RATE_API_KEY=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Scheduled jobs
CRON_SECRET=

# Piece 9: PREVIEW ONLY. Leave disabled in production. No public client-side flag.
PIECE9_PREVIEW_ENABLED=false
CRYSTRACK_ENV=
# Production reference is used only to reject using the same Supabase host in preview.
PIECE9_PRODUCTION_SUPABASE_URL=
# On a preview deployment, NEXT_PUBLIC_SUPABASE_URL and credentials must point to staging.
PIECE9_PREVIEW_APP_URL=
# Generate a separate random signing key, at least 32 characters. Never reuse production secrets.
PIECE9_SIGNING_SECRET=
PIECE9_TELEGRAM_BOT_TOKEN=
PIECE9_TELEGRAM_BOT_USERNAME=
PIECE9_TELEGRAM_WEBHOOK_SECRET=
