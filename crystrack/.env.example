# CrysTrack application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Database
DATABASE_URL=

# AI - OpenRouter
OPENROUTER_API_KEY=

# Verified private OpenRouter model used by CrysTrack.
# Application code defaults to this model if overrides are omitted.
OPENROUTER_CHAT_MODEL=openai/gpt-oss-20b
OPENROUTER_ANALYSIS_MODEL=openai/gpt-oss-20b

# Exchange rates
EXCHANGE_RATE_API_KEY=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Scheduled jobs
CRON_SECRET=

# Preview safety (server-only; ignored for normal production builds).
# Set ONLY for a separately approved credential-free Preview build; keep automatic deployments OFF.
# Allowed reviewed value: synthetic-v1. Missing/other values fail closed when VERCEL_ENV=preview.
CRYSTRACK_PREVIEW_MODE=
# NEXT_PUBLIC_CRYSTRACK_RUNTIME is generated by next.config.js, never set manually.

# Inert by default. API/cron stop only; DB freeze and old worker shutdown are separate gates.
CRYSTRACK_TASK_WRITE_MAINTENANCE=off
